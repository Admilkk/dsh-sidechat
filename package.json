{
  "name": "dsh-codex-sidechat",
  "version": "0.2.3",
  "description": "Codex-style side conversations for DeepSeek Harness.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./query-view": "./lib/query-view.js",
    "./persistence": "./lib/persistence.js"
  },
  "files": [
    "lib",
    "src",
    "tests",
    "scripts",
    "preview",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test && node scripts/check-package.mjs",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.1-rc.3"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Admilkk/dsh-sidechat.git"
  },
  "homepage": "https://github.com/Admilkk/dsh-sidechat#readme",
  "bugs": {
    "url": "https://github.com/Admilkk/dsh-sidechat/issues"
  },
  "author": "Admilkk",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sidechat",
    "codex"
  ]
}
